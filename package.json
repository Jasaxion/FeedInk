{
  "name": "feedink",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "npm run build -w @feedink/ink && npm run build -w @feedink/shared && npm run build -w @feedink/web && npm run build -w @feedink/api",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json",
    "test": "npm run test --workspaces --if-present && npm run test:fixtures",
    "test:fixtures": "node --test tests/fixtures/*.test.mjs",
    "test:e2e": "playwright test",
    "dev:api": "npm run dev -w @feedink/api",
    "dev:web": "npm run dev -w @feedink/web"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.0",
    "fflate": "0.8.2"
  }
}
