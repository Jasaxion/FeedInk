    "test:shell": "node test/shell-update.mjs",
    "test:images": "node test/portable-images.mjs",
    "test:offline-origin": "node test/offline-origin.mjs",
    "test:residual": "node test/residual-browser.mjs",
    "test:annotations": "node test/annotations-browser.mjs",
    "test:ai": "node test/ai-browser.mjs"
  },
  "dependencies": {
    "@feedink/shared": "1.0.0",
    "@feedink/ink": "1.0.0",
    "dompurify": "^3.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
