# Copy to .env, chmod 600, and replace both secrets before starting.
COMPOSE_PROJECT_NAME=feedink
APP_URL=https://reader.example.com
APP_BIND=127.0.0.1
APP_PORT=3000
FEEDINK_IMAGE=feedink:local
# For restricted registries, use the equivalent official public.ecr.aws/docker/library/* mirror.
NODE_IMAGE=node:24.22.3-bookworm-slim
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=feedink
POSTGRES_USER=feedink
# Generate URL-safe hex: openssl rand -hex 32 (separately for EACH secret).
# Do not use ':' '/' '@' '$' or other URL/Compose-significant characters in the DB password.
POSTGRES_PASSWORD=
SESSION_SECRET=
# Optional AI. Generate once: openssl rand -base64 32. Preserve separately with private deployment configuration.
# This is NOT a provider API key. Each non-demo account saves its encrypted provider key in Settings.
AI_ENCRYPTION_KEY=
# Empty permits public HTTPS providers only. Exact private model hosts require explicit operator authorization.
AI_ALLOW_HOSTS=
# Filesystem is the default. /data remains required for durable staging even with S3.
STORAGE_BACKEND=filesystem
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_PREFIX=feedink/
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_ALLOW_HTTP=false
# Operator-only S3 credentials; leave empty for filesystem or a separately configured SDK credential provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Public registration never grants administrator permissions. Leave closed unless intended.
REGISTRATION_ENABLED=false
# Operator bootstrap CLI identity; no elevation by matching a public registration email.
ADMIN_EMAIL=
ADMIN_NAME=Administrator
# Pass ADMIN_PASSWORD_FILE=/dev/stdin ONLY to the one-off bootstrap command (see deployment docs).
# Never put the administrator password in .env, command arguments or container environment.
# Empty means trust no forwarded client IPs. Use only actual proxy IPs/CIDRs, never universal ranges.
TRUST_PROXY=
# Optional. Leave SMTP_HOST empty to disable mail; demo users cannot send mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
